// Configuration reference only. Configure bindings and secrets through the Cloudflare Dashboard.
// Site files are served from the private R2 site/ prefix; no static-asset binding or build step.
{
  "name": "pinoylegends",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pinoy-legends-db",
      "database_id": "344fae79-3f25-46cd-ab2a-73458338e67f"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "pinoy-legends-assets"
    }
  ]
}
