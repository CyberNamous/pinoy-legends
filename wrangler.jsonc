{
  "name": "pinoylegends",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "vars": {
    "DISCORD_CLIENT_ID": "1560692101925310524",
    "DISCORD_REDIRECT_URI": "https://pinoylegends.cybernamous.workers.dev/auth/callback",
    "OWNER_DISCORD_ID": "525629510293389323" ,
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF0RV4sMI0Ea74ys" ,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pinoy-legends-db",
      "database_id": "344fae79-3f25-46cd-ab2a-73458338e67f"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "pinoy-legends-assets"
    }
  ]
}
